# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
# Requires the pgvector extension enabled: create extension if not exists vector;
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# NVIDIA API Catalog key (build.nvidia.com) — used for LLM + embedding calls via NIM
NVIDIA_API_KEY=

# Cohere Rerank key (dashboard.cohere.com) — used for reranking retrieved chunks
COHERE_API_KEY=
